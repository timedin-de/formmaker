{
  "id": "form_order",
  "name": "Order registration",
  "description": "",
  "version": 1,
  "schemaVersion": 2,
  "settings": {
    "name": "Order registration",
    "submitLabel": "Send order",
    "showProgress": true,
    "allowBack": true,
    "navigation": "auto",
    "enableAutoSave": true
  },
  "pages": [
    {
      "id": "p1",
      "title": "Personal data",
      "subtitle": "Step 1 of 2",
      "children": [
        "sec_main",
        "q_name",
        "q_email",
        "q_phone",
        "q_website",
        "q_dob",
        "q_time",
        "q_when",
        "q_terms",
        "q_favorite",
        "q_country",
        "q_tags",
        "q_price",
        "q_quantity",
        "q_bio",
        "q_rating",
        "q_upload",
        "td_signed",
        "grp_addr",
        "grp_sign"
      ]
    },
    {
      "id": "p2",
      "title": "Done",
      "enabledWhen": {
        "logic": "all",
        "conditions": [{ "fieldId": "q_bio", "operator": "isNotEmpty" }],
        "groups": []
      },
      "children": ["sec_end", "td_end"]
    }
  ],
  "elements": {
    "sec_main": {
      "id": "sec_main",
      "type": "section",
      "width": 1,
      "label": "Primary fields",
      "description": ""
    },
    "q_name": {
      "id": "q_name",
      "type": "text",
      "label": "Full name",
      "description": "",
      "width": 1,
      "required": true,
      "readonly": false,
      "validations": [
        { "id": "v1", "rule": "minLength", "value": 2, "message": "Name too short" },
        { "id": "v2", "rule": "pattern", "pattern": "^[A-Za-z ,.'-]+$" },
        { "id": "v25", "rule": "maxLength", "value": 120 }
      ],
      "defaultValue": { "kind": "static", "value": "Jane Doe" },
      "placeholder": "e.g. Jane Doe",
      "inputType": "text"
    },
    "q_email": {
      "id": "q_email",
      "type": "text",
      "label": "Email",
      "width": 0.5,
      "required": true,
      "validations": [{ "id": "v3", "rule": "email" }],
      "defaultValue": { "kind": "fromField", "fieldId": "q_name" },
      "placeholder": "you@mail.com",
      "inputType": "email"
    },
    "q_phone": {
      "id": "q_phone",
      "type": "text",
      "label": "Phone",
      "width": 0.5,
      "validations": [
        { "id": "v4", "rule": "phone" },
        { "id": "v5", "rule": "maxLength", "value": 20 }
      ],
      "defaultValue": null,
      "placeholder": "+1 ...",
      "inputType": "phone",
      "enabledWhen": {
        "logic": "all",
        "conditions": [{ "fieldId": "q_country", "operator": "in", "values": ["US", "UK"] }],
        "groups": []
      }
    },
    "q_website": {
      "id": "q_website",
      "type": "text",
      "label": "Website",
      "width": 1,
      "validations": [{ "id": "v6", "rule": "url" }],
      "defaultValue": null,
      "placeholder": "https://…",
      "inputType": "url",
      "enabledWhen": {
        "logic": "any",
        "conditions": [
          {
            "fieldId": "q_terms",
            "operator": "eq",
            "operand": { "kind": "literal", "value": true }
          }
        ],
        "groups": []
      }
    },
    "q_dob": {
      "id": "q_dob",
      "type": "date",
      "label": "Date of birth",
      "width": 0.5,
      "required": true,
      "validations": [
        { "id": "v7", "rule": "dateMin", "value": "1900-01-01" },
        { "id": "v8", "rule": "dateMax", "value": "2010-12-31" }
      ],
      "defaultValue": { "kind": "expression", "expression": "now()" },
      "placeholder": "yyyy-mm-dd"
    },
    "q_time": {
      "id": "q_time",
      "type": "time",
      "label": "Preferred call time",
      "width": 0.5,
      "defaultValue": { "kind": "static", "value": "14:30" },
      "timeInterval": { "value": 15, "multiplier": "60" },
      "placeholder": "HH:mm"
    },
    "q_when": {
      "id": "q_when",
      "type": "dateTime",
      "label": "Event start",
      "width": 1,
      "defaultValue": null,
      "timeInterval": { "value": 30, "multiplier": "60" },
      "placeholder": "yyyy-mm-dd HH:mm"
    },
    "q_terms": {
      "id": "q_terms",
      "type": "boolean",
      "label": "Accept terms",
      "width": 1,
      "required": true,
      "validations": [{ "id": "v9", "rule": "required", "message": "You must accept the terms" }],
      "defaultValue": { "kind": "static", "value": true }
    },
    "q_favorite": {
      "id": "q_favorite",
      "type": "choice",
      "label": "Favorite color",
      "width": 0.5,
      "validations": [],
      "defaultValue": { "kind": "static", "value": "choc" },
      "options": [
        { "id": "blue", "label": "Blue" },
        { "id": "choc", "label": "Chocolate" },
        { "id": "green", "label": "Green" }
      ]
    },
    "q_country": {
      "id": "q_country",
      "type": "dropdown",
      "label": "Country",
      "width": 0.5,
      "validations": [{ "id": "v10", "rule": "required" }],
      "defaultValue": null,
      "options": [
        { "id": "DE", "label": "Germany" },
        { "id": "US", "label": "United States" },
        { "id": "UK", "label": "United Kingdom" }
      ]
    },
    "q_tags": {
      "id": "q_tags",
      "type": "multiChoice",
      "label": "Interests",
      "width": 1,
      "validations": [{ "id": "v11", "rule": "required" }],
      "defaultValue": { "kind": "static", "value": ["a", "b"] },
      "options": [
        { "id": "a", "label": "AI" },
        { "id": "b", "label": "Web" },
        { "id": "c", "label": "Mobile" }
      ]
    },
    "q_price": {
      "id": "q_price",
      "type": "number",
      "label": "Price for {{q_name | title}}",
      "width": 0.5,
      "validations": [
        { "id": "v12", "rule": "number" },
        { "id": "v13", "rule": "min", "value": 10 },
        { "id": "v14", "rule": "between", "value": 10, "valueTo": 500 },
        {
          "id": "v15",
          "rule": "custom",
          "expression": "if(q_price > 500, msg('Too expensive, max 500'), true)"
        }
      ],
      "defaultValue": { "kind": "static", "value": 49.99 },
      "placeholder": "0.00",
      "step": 0.01,
      "unit": "USD",
      "decimals": 2
    },
    "q_quantity": {
      "id": "q_quantity",
      "type": "text",
      "label": "Quantity (text, numeric input)",
      "width": 0.5,
      "validations": [
        { "id": "v16", "rule": "integer" },
        { "id": "v17", "rule": "min", "value": 1 },
        { "id": "v18", "rule": "max", "value": 99 }
      ],
      "defaultValue": null,
      "placeholder": "1",
      "inputType": "number"
    },
    "q_bio": {
      "id": "q_bio",
      "type": "longText",
      "label": "Bio",
      "width": 1,
      "required": true,
      "validations": [
        { "id": "v19", "rule": "maxLength", "value": 1000, "message": "Max 1000 chars" }
      ],
      "defaultValue": null,
      "placeholder": "About you…",
      "rows": 6,
      "enabledWhen": {
        "logic": "any",
        "conditions": [
          {
            "fieldId": "q_quantity",
            "operator": "gte",
            "operand": { "kind": "literal", "value": 5 }
          }
        ],
        "groups": []
      }
    },
    "q_rating": {
      "id": "q_rating",
      "type": "scale",
      "label": "Overall rating",
      "width": 1,
      "validations": [],
      "defaultValue": { "kind": "expression", "expression": "round(avg(q_rating), 0)" },
      "min": 1,
      "max": 5,
      "step": 1,
      "minLabel": "Poor",
      "maxLabel": "Excellent"
    },
    "q_upload": {
      "id": "q_upload",
      "type": "file",
      "label": "Documents",
      "width": 1,
      "validations": [
        { "id": "v20", "rule": "minFiles", "value": 1 },
        { "id": "v21", "rule": "maxFiles", "value": 5 },
        { "id": "v22", "rule": "fileSizeMaxMb", "value": 10 },
        { "id": "v23", "rule": "fileType", "accept": "image/png,.pdf" }
      ],
      "defaultValue": null,
      "accept": "image/png,.pdf",
      "multiple": true,
      "enabledWhen": {
        "logic": "all",
        "conditions": [{ "fieldId": "q_tags", "operator": "hasAnyOf", "values": ["a", "b"] }],
        "groups": [
          {
            "logic": "any",
            "conditions": [
              {
                "fieldId": "q_quantity",
                "operator": "gt",
                "operand": { "kind": "literal", "value": 10 }
              }
            ],
            "groups": []
          }
        ]
      }
    },
    "td_signed": {
      "id": "td_signed",
      "type": "textdisplay",
      "width": 1,
      "label": "Dear {{q_name | title}}, thank you for choosing {{q_favorite | upper}}.",
      "description": ""
    },
    "grp_addr": {
      "id": "grp_addr",
      "type": "group",
      "label": "Address group",
      "width": 1,
      "defaultValue": null,
      "collapsible": true,
      "children": ["q_street", "q_city"]
    },
    "q_street": {
      "id": "q_street",
      "type": "text",
      "label": "Street",
      "width": 1,
      "defaultValue": null,
      "placeholder": "…",
      "inputType": "text"
    },
    "q_city": {
      "id": "q_city",
      "type": "text",
      "label": "City",
      "width": 0.5,
      "defaultValue": null,
      "placeholder": "City in {{q_country | lower}}",
      "inputType": "text"
    },
    "grp_sign": {
      "id": "grp_sign",
      "type": "group",
      "label": "Attestation",
      "width": 1,
      "defaultValue": null,
      "collapsible": false,
      "children": ["q_sign"]
    },
    "q_sign": {
      "id": "q_sign",
      "type": "signature",
      "label": "Signature",
      "width": 1,
      "required": true,
      "validations": [{ "id": "v24", "rule": "required", "message": "Please sign" }],
      "defaultValue": null
    },
    "sec_end": { "id": "sec_end", "type": "section", "width": 1, "label": "", "description": "" },
    "td_end": {
      "id": "td_end",
      "type": "textdisplay",
      "width": 1,
      "label": "We'll contact you at {{q_email}}.",
      "description": ""
    }
  }
}
